      {
        "_comment": "BUG \u2014 the client revalidates with the exact tag it was given (\"13b-658b017f9d000-gzip\"). Apache compares it against the identity tag \"13b-658b017f9d000\", they never match, so it answers 200 and re-sends the body. RFC 9110 s13.1.2 says this must be a 304.",
        "startedDateTime": "2026-09-09T02:44:50.400Z",
        "time": 15,
        "request": {
          "method": "GET",
          "url": "http://localhost:18080/plain/big.txt",
          "httpVersion": "HTTP/1.1",
          "headers": [
            {
              "name": "Host",
              "value": "localhost:18080"
            },
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Apache ETag study \u2014 see https://amoshydra.github.io/blog/)"
            },
            {
              "name": "Accept-Encoding",
              "value": "gzip"
            },
            {
              "name": "If-None-Match",
              "value": "\"13b-658b017f9d000-gzip\""
            }
          ],
          "queryString": [],
          "cookies": [],
          "headersSize": -1,
          "bodySize": 0
        },
        "response": {
          "status": 200,
          "statusText": "OK",
          "httpVersion": "HTTP/1.1",
          "headers": [
            {
              "name": "Date",
              "value": "Wed, 09 Sep 2026 02:44:50 GMT"
            },
