      {
        "_comment": "a 304 only happens if the client sends the identity tag \"13b-658b017f9d000\" \u2014 a tag it was never given. And it is malformed: the ETag is \"13b-658b017f9d000\" (not \"13b-658b017f9d000-gzip\") and Vary / Content-Encoding are missing, which RFC 9110 s15.4.5 requires a 304 to carry.",
        "startedDateTime": "2026-09-09T02:44:50.600Z",
        "time": 17,
        "request": {
          "method": "GET",
          "url": "http://localhost:18080/plain/big.txt",
          "httpVersion": "HTTP/1.1",
          "headers": [
            {
              "name": "Host",
              "value": "localhost:18080"
            },
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (Apache ETag study \u2014 see https://amoshydra.github.io/blog/)"
            },
            {
              "name": "Accept-Encoding",
              "value": "gzip"
            },
            {
              "name": "If-None-Match",
              "value": "\"13b-658b017f9d000\""
            }
          ],
          "queryString": [],
          "cookies": [],
          "headersSize": -1,
          "bodySize": 0
        },
        "response": {
          "status": 304,
          "statusText": "Not Modified",
          "httpVersion": "HTTP/1.1",
