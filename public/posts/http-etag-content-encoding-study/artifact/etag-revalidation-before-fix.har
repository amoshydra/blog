            "size": 69,
            "mimeType": "application/octet-stream",
            "text": "H4sIAAAAAAAAAwvJSFUoLM1MzlZIKsovz1NIy69QyCrNLShWyC9LLVIoAUrnJFZVKqTkp+sphIwqRlIMAA7EP2U7AQAA",
