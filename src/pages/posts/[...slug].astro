---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Table from "../../components/mdx/Table.astro";
import Collapsible from "../../components/mdx/Collapsible.astro";
import HtmlXmlCompare from "../../components/mdx/HtmlXmlCompare.astro";
import PatternDemo from "../../components/mdx/PatternDemo.astro";
import BlogPost from "../../layouts/BlogPost.astro";

export async function getStaticPaths() {
    const posts = await getCollection("posts");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: post,
    }));
}
type Props = CollectionEntry<"posts">;

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
  <Content
    components={{
      table: Table,
      Collapsible,
      HtmlXmlCompare,
      PatternDemo
    }}
  />
</BlogPost>
