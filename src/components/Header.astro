---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="header">
  <div class="header-slot">
    <slot />
  </div>
  <ThemeToggle />
</header>

<style>
.header {
  margin: 0;
  padding: 0 1em;
  background: rgb(var(--white));
  border-bottom: 1px solid var(--border-subtle);
  box-shadow: 0 2px 8px rgba(var(--black), 5%);
  position: sticky;
  top: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  min-height: 3rem;
}
.header-slot {
  display: flex;
  align-items: center;
  min-width: 0;
}
</style>
