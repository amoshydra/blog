---
const props = Astro.props;
---

<div class="scrollable-table">
  <table {...props}>
    <slot />
  </table>
</div>

<style>
/* Layout hook only. The rehype plugin wraps every markdown table in
   .table-scroll, which owns the horizontal scrolling; adding overflow here too
   would nest two scroll containers and hide the scrollbar. */
.scrollable-table {
  margin: auto;
}
</style>