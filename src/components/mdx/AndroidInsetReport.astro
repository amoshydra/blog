---
// "What Android reports, before and after the keyboard", as a live component.
//
// Replaces android-insets-before-after.webp. The title and the measurement line
// that were baked into that image now live in the post's prose, so this file only
// carries the two panels and their tables.
//
// The numbers are CSS pixels from the Pixel 7 Pro run (Android 17), logged from
// Gadgetbridge's app-manager screen and divided by the device's 2.975 pixel ratio.
// The phone mocks are drawn, not captured, and they stay dark in both themes
// because they stand in for a device.
---
<figure class="air">
  <div class="air-panels">
    <div class="air-panel">
      <div class="air-h">Keyboard closed</div>
      <div class="air-mini">
        <span class="air-status" aria-hidden="true"></span>
        <span class="air-cut" aria-hidden="true"></span>
        <span class="air-nav" aria-hidden="true"></span>
        <span class="air-tag" style="top:40px">statusBars() top = 112</span>
        <span class="air-tag" style="top:58px">displayCutout() top = 48</span>
        <span class="air-tag" style="bottom:30px">navigationBars() = 24</span>
      </div>
      <table class="air-table">
        <tbody>
          <tr><td>statusBars() top</td><td>112</td></tr>
          <tr><td>displayCutout() top</td><td>48</td></tr>
          <tr><td>navigationBars() bottom</td><td>24</td></tr>
          <tr><td>ime() bottom</td><td>0</td></tr>
          <tr class="sum"><td><code>systemBars()</code> = status + nav + caption</td><td>24</td></tr>
        </tbody>
      </table>
    </div>

    <div class="air-panel open">
      <div class="air-h">Keyboard open</div>
      <div class="air-mini">
        <span class="air-status" aria-hidden="true"></span>
        <span class="air-cut" aria-hidden="true"></span>
        <span class="air-nav kb" aria-hidden="true"></span>
        <span class="air-tag" style="top:40px">statusBars() top = 112</span>
        <span class="air-tag" style="top:58px">displayCutout() top = 48</span>
        <span class="air-tag warn" style="bottom:102px">navigationBars() = 325 &larr; the keyboard</span>
        <span class="air-tag warn" style="bottom:8px">IME</span>
      </div>
      <table class="air-table">
        <tbody>
          <tr><td>statusBars() top</td><td>112</td></tr>
          <tr><td>displayCutout() top</td><td>48</td></tr>
          <tr><td>navigationBars() bottom</td><td class="open">325</td></tr>
          <tr><td>ime() bottom</td><td class="open">325</td></tr>
          <tr class="sum"><td><code>systemBars()</code> = status + nav + caption</td><td class="open">325</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</figure>

<style>
  .air {
    width: 100%;
    max-width: 44rem;
    margin: 2rem auto;
    padding: 1rem 1.15rem 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    background: rgba(var(--gray-light), 0.28);
  }
  .air-panels { display: flex; gap: 1.1rem; align-items: flex-start; }
  .air-panel {
    flex: 1 1 0;
    min-width: 0;
    padding: 0.85rem 0.9rem 0.7rem;
    border: 1px solid var(--border-subtle);
    border-radius: 0.6rem;
    background: rgb(var(--white));
  }
  .air-panel.open { border-color: var(--tx-point); }
  .air-h {
    margin-bottom: 0.7rem;
    font-weight: 600; font-size: 0.85rem;
    color: rgb(var(--gray-dark));
  }
  .air-panel.open .air-h { color: var(--tx-point); }

  /* The device mock. Dark in both themes; its labels are fixed light. */
  .air-mini {
    position: relative;
    width: 150px; height: 300px;
    margin: 0 auto 0.85rem;
    border: 2px solid #2a2a31;
    border-radius: 0.7rem;
    background: #101013;
    overflow: hidden;
  }
  .air-status { position: absolute; left: 0; right: 0; top: 0; height: 34px; background: #1b1b21; }
  .air-cut {
    position: absolute; left: 50%; top: 0; transform: translateX(-50%);
    width: 34px; height: 16px; background: #0b0b0d; border-radius: 0 0 0.5rem 0.5rem;
  }
  .air-nav { position: absolute; left: 0; right: 0; bottom: 0; height: 22px; background: #1b1b21; }
  .air-nav.kb {
    height: 96px;
    background: repeating-linear-gradient(135deg, #22222a, #22222a 8px, #262630 8px, #262630 16px);
  }
  .air-tag { position: absolute; right: 6px; font-size: 0.62rem; line-height: 1.3; color: #9a9aa6; }
  .air-tag.warn { color: #fbbf24; }

  .air-table { width: 100%; border-collapse: collapse; font-size: 0.78rem; }
  .air-table td {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: top;
    color: rgb(var(--gray));
  }
  .air-table tr:last-child td { border-bottom: 0; }
  .air-table td:first-child { width: 56%; }
  .air-table td:last-child {
    font-family: var(--font-family-mono);
    text-align: right; white-space: nowrap;
  }
  .air-table .sum td { color: rgb(var(--gray-dark)); font-weight: 600; }
  .air-table .open { color: var(--tx-point); font-weight: 600; }
  .air-table code { font-family: var(--font-family-mono); font-size: 0.74rem; color: var(--accent); }

  @media (max-width: 40rem) {
    .air { padding: 0.85rem 0.85rem 1rem; }
    .air-panels { flex-direction: column; gap: 0.8rem; }
    .air-mini { width: 132px; height: 264px; }
    .air-tag { font-size: 0.58rem; }
  }
</style>
