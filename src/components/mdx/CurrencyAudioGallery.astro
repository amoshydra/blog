---
import fs from "node:fs";
import path from "node:path";
import { renderTranscriptHtml } from "../../lib/transcript-render.mjs";

// Cross-engine comparison gallery for the screen-reader currency tests.
//
//   A = Google TTS 103.12.8 (human-verified transcripts)
//   B = Google TTS 20260817 (verified)
//   C = eSpeak NG           (open engine, phonemes)
//   D = Microsoft OneCore   (Windows 10 22H2, engine 10.3.21207.0)
//
// Two columns: the input, and a "Read-out" column where each engine is stacked
// vertically. A is always shown; B/C/D are behind labelled toggles.
const slug = "screen-reader-currency-announcements";
const artifacts = path.join(process.cwd(), "public", "posts", slug, "artifacts");
const contentDir = path.join(process.cwd(), "content", "posts", slug);
const relBase = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const SPECS = {
  a: {
    id: "a",
    short: "A",
    label: "103.12.8",
    year: "2023",
    kind: "words",
    manifest: "RESULTS-gtts-locales.tsv",
    clips: "gtts",
    transcripts: "transcripts.json",
    roman: "transcripts.romanized.json",
  },
  b: {
    id: "b",
    short: "B",
    label: "20260817",
    year: "2026",
    kind: "words",
    manifest: "RESULTS-gtts-locales-20260817.tsv",
    clips: "gtts/20260817",
    transcripts: "transcripts.20260817.json",
    roman: "transcripts.20260817.romanized.json",
  },
  c: {
    id: "c",
    short: "C",
    label: "eSpeak NG",
    year: "",
    kind: "phonemes",
    manifest: "RESULTS-espeak-locales.tsv",
    clips: "espeak",
    transcripts: "transcripts.espeak.json",
    roman: null,
    noVoiceLocales: ["en-IN"],
  },
  d: {
    id: "d",
    short: "D",
    label: "OneCore",
    year: "Win 10 22H2",
    kind: "words",
    manifest: "RESULTS-gtts-windows-onecore.tsv",
    clips: "onecore",
    transcripts: "transcripts.onecore.json",
    roman: "transcripts.onecore.romanized.json",
    noVoiceLocales: [],
  },
};

const ESC = { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" };
const escapeHtml = (s) => s.replace(/[&<>"]/g, (c) => ESC[c]);

function readJson(file) {
  try {
    return JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    return {};
  }
}

function loadEngine(spec) {
  const manifestPath = path.join(artifacts, spec.manifest);
  if (!fs.existsSync(manifestPath)) return null;
  const clipsDir = path.join(artifacts, spec.clips);
  const rows: { locale: string; form: string; file: string }[] = [];
  for (const line of fs.readFileSync(manifestPath, "utf8").split("\n")) {
    if (!line.trim() || line.startsWith("#") || line.startsWith("locale\t")) continue;
    const [locale, form, file] = line.split("\t");
    if (locale && form && file && fs.existsSync(path.join(clipsDir, file))) rows.push({ locale, form, file });
  }
  const transcripts: Record<string, string> = readJson(path.join(contentDir, spec.transcripts));
  const romanized: Record<string, string> = spec.roman ? readJson(path.join(contentDir, spec.roman)) : {};
  const cells = new Map<string, { url: string; html: string; predicted: boolean; roman: string }>();
  for (const r of rows) {
    const raw = (transcripts[r.file] ?? "").trim();
    const predicted = raw.startsWith("~");
    const text = predicted ? raw.replace(/^~\s*/, "") : raw;
    cells.set(`${r.locale}\u0000${r.form}`, {
      url: `${relBase}posts/${slug}/artifacts/${spec.clips}/${r.file}`,
      html: spec.kind === "phonemes" ? escapeHtml(text) : renderTranscriptHtml(text, r.locale),
      predicted,
      roman: (romanized[r.file] ?? "").trim(),
    });
  }
  return { ...spec, rows, cells };
}

const data = { a: loadEngine(SPECS.a), b: loadEngine(SPECS.b), c: loadEngine(SPECS.c), d: loadEngine(SPECS.d) };

const engines = [
  {
    ...SPECS.a,
    label: data.a.label,
    year: data.a.year,
    none: "",
    tag: null,
    cellLabel: `A · ${data.a.label}`,
    toggle: null,
  },
  data.b && {
    ...SPECS.b,
    label: data.b.label,
    year: data.b.year,
    none: "not captured",
    tag: null,
    cellLabel: `B · ${data.b.label}`,
    toggle: { aria: `${data.b.label} (${data.b.year})` },
  },
  data.c && {
    ...SPECS.c,
    none: "not captured",
    tag: "phonemes",
    cellLabel: "C · eSpeak NG",
    toggle: {
      show: "Show eSpeak NG · open engine (phonemes)",
      hide: "Hide eSpeak NG",
      aria: "eSpeak NG open engine, phonemes",
    },
  },
  data.d && {
    ...SPECS.d,
    none: "not captured",
    tag: null,
    cellLabel: `D · ${SPECS.d.label}`,
    toggle: { aria: "Microsoft OneCore (Windows)" },
  },
].filter(Boolean);

const groups: {
  locale: string;
  rows: { form: string; cells: Record<string, ReturnType<typeof data.a.cells.get>> }[];
}[] = [];
const seen = new Set<string>();
for (const r of data.a.rows) {
  const key = `${r.locale}\u0000${r.form}`;
  if (seen.has(key)) continue;
  seen.add(key);
  let group = groups.find((g) => g.locale === r.locale);
  if (!group) {
    group = { locale: r.locale, rows: [] };
    groups.push(group);
  }
  const cells: Record<string, ReturnType<typeof data.a.cells.get>> = {};
  for (const e of engines) cells[e.id] = data[e.id].cells.get(key);
  group.rows.push({ form: r.form, cells });
}
const total = groups.reduce((n, g) => n + g.rows.length, 0);
---

<div class="cmp" data-a="1" data-b="1" data-c="0" data-d="1">
  <div class="cmp__bar">
    <p class="cmp__title">
      {total} forms <span class="cmp__title-sub">A = {data.a.label} ({data.a.year}){data.b ? ` · B = ${data.b.label} (${data.b.year})` : ""}{data.d ? ` · D = ${data.d.label} (${data.d.year})` : ""}</span>
    </p>
    <div class="cmp__engines" role="group" aria-label="Engines to show">
      <span class="cmp__engines-label">Engines</span>
      {
        engines.map((e) => (
          <button
            type="button"
            class="cmp__chip"
            data-engine={e.id}
            aria-pressed={e.id === "a" || e.id === "b" || e.id === "d" ? "true" : "false"}
            aria-label={`Toggle the ${e.label} read-out`}
            title={e.toggle ? e.toggle.aria : `${e.label}${e.year ? ` (${e.year})` : ""}`}
          >
            <span class="cmp__chip-mark" aria-hidden="true" />
            <span class="cmp__chip-name">{e.short} · {e.label}</span>
            {e.tag && <span class="cmp__chip-tag">{e.tag}</span>}
          </button>
        ))
      }
      <button type="button" class="cmp__all" aria-pressed="false">All</button>
    </div>
  </div>

  <div class="cmp__table" role="table" aria-label="Currency read-outs across TTS engines">
    <div class="cmp__head" role="row">
      <div class="cmp__th" role="columnheader">Input</div>
      <div class="cmp__th" role="columnheader">Read-out</div>
    </div>

    {
      groups.map((group) => (
        <div class="cmp__group" role="rowgroup">
          <div class="cmp__group-head" role="row">
            <div class="cmp__locale" role="cell">{group.locale}</div>
          </div>
          {group.rows.map((row) => (
            <div class="cmp__row" role="row" data-open="0">
              <div class="cmp__cell cmp__input" role="cell" data-label="Input">
                <span class="cmp__form">{row.form}</span>
                <button
                  type="button"
                  class="cmp__more"
                  aria-expanded="false"
                  aria-label={`Show the full read-out for ${group.locale} ${row.form}`}
                >
                  ⌄
                </button>
              </div>

              <div class="cmp__cell cmp__stack" role="cell" data-label="Read-out">
                {engines.map((e) => {
                  const cell = row.cells[e.id];
                  const missing = (e.noVoiceLocales ?? []).includes(group.locale) ? "no voice" : e.none;
                  return (
                    <div class={`cmp__lang cmp__col--${e.id}`}>
                      <span class="cmp__lang-label">{e.short} · {e.label}</span>
                      {cell ? (
                        <>
                          <button
                            type="button"
                            class="cmp__play"
                            data-play={cell.url}
                            aria-label={`Play the ${e.label} read-out for ${group.locale} ${row.form}`}
                          >
                            ▶
                          </button>
                          <span
                            class={`cmp__text${cell.predicted ? " cmp__text--pred" : ""}${e.kind === "phonemes" ? " cmp__text--phon" : ""}`}
                            set:html={cell.html}
                          />
                          {cell.roman && <span class="cmp__roman">{cell.roman}</span>}
                        </>
                      ) : (
                        <span class="cmp__none">{missing}</span>
                      )}
                    </div>
                  );
                })}
              </div>
            </div>
          ))}
        </div>
      ))
    }
  </div>
</div>

<script>
  // Astro bundles this as a module; no document.currentScript. Bind per root.
  const audio = new Audio();
  audio.preload = "none";

  // Show the expand chevron only where a transcript is actually clamped.
  function textOverflows(el: HTMLElement) {
    const rect = el.getBoundingClientRect();
    const clone = el.cloneNode(true) as HTMLElement;
    clone.style.position = "absolute";
    clone.style.visibility = "hidden";
    clone.style.display = "block";
    clone.style.webkitLineClamp = "unset";
    clone.style.width = `${rect.width}px`;
    el.parentElement?.appendChild(clone);
    const natural = clone.getBoundingClientRect().height;
    clone.remove();
    return natural > rect.height + 1;
  }

  function syncMore(root: HTMLElement) {
    for (const row of root.querySelectorAll<HTMLElement>(".cmp__row")) {
      const btn = row.querySelector<HTMLButtonElement>(".cmp__more");
      if (!btn) continue;
      if (row.dataset.open === "1") {
        btn.hidden = false;
        continue;
      }
      const overflow = [...row.querySelectorAll<HTMLElement>(".cmp__text")].some(textOverflows);
      btn.hidden = !overflow;
    }
  }

  const roots = [...document.querySelectorAll<HTMLElement>(".cmp")];
  for (const root of roots) {
    if (root.dataset.bound) continue;
    root.dataset.bound = "1";

    for (const chip of root.querySelectorAll<HTMLButtonElement>(".cmp__chip")) {
      chip.addEventListener("click", () => {
        const id = chip.dataset.engine ?? "";
        const on = root.dataset[id] === "1";
        root.dataset[id] = on ? "0" : "1";
        chip.setAttribute("aria-pressed", on ? "false" : "true");
        syncMore(root);
      });
    }

    const all = root.querySelector<HTMLButtonElement>(".cmp__all");
    if (all) {
      all.addEventListener("click", () => {
        const chips = [...root.querySelectorAll<HTMLButtonElement>(".cmp__chip")];
        const everyOn = chips.every((c) => root.dataset[c.dataset.engine ?? ""] === "1");
        for (const c of chips) {
          root.dataset[c.dataset.engine ?? ""] = everyOn ? "0" : "1";
          c.setAttribute("aria-pressed", everyOn ? "false" : "true");
        }
        all.setAttribute("aria-pressed", everyOn ? "false" : "true");
        syncMore(root);
      });
    }

    for (const p of root.querySelectorAll<HTMLButtonElement>(".cmp__play")) {
      p.addEventListener("click", () => {
        const src = p.dataset.play ?? "";
        if (audio.src.endsWith(src) && !audio.paused) {
          audio.pause();
          return;
        }
        audio.src = src;
        audio.play().catch(() => {});
      });
    }

    for (const m of root.querySelectorAll<HTMLButtonElement>(".cmp__more")) {
      m.addEventListener("click", () => {
        const row = m.closest<HTMLElement>(".cmp__row");
        if (!row) return;
        const open = row.dataset.open === "1";
        row.dataset.open = open ? "0" : "1";
        m.setAttribute("aria-expanded", open ? "false" : "true");
        syncMore(root);
      });
    }

    syncMore(root);
  }

  if (roots.length) {
    let t = 0;
    window.addEventListener("resize", () => {
      window.clearTimeout(t);
      t = window.setTimeout(() => roots.forEach(syncMore), 150);
    });
  }
</script>

<style>
  .cmp {
    --cmp-cols: 10rem minmax(0, 1fr);
    margin: 1.25rem auto 2.5rem;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    overflow: hidden;
  }

  .cmp__bar {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.7rem;
    background-color: rgb(var(--white));
    border-bottom: 1px solid var(--border-subtle);
  }
  .cmp__title {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
  }
  .cmp__title-sub {
    color: rgb(var(--gray));
    font-weight: 400;
    margin-left: 0.35rem;
  }
  .cmp__engines {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .cmp__engines-label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgb(var(--gray));
    margin-right: 0.1rem;
  }
  .cmp__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font: inherit;
    font-size: 0.78rem;
    padding: 0.24rem 0.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: transparent;
    color: rgb(var(--gray));
    cursor: pointer;
    opacity: 0.6;
  }
  .cmp__chip[aria-pressed="true"] {
    opacity: 1;
    color: inherit;
    background: rgb(var(--gray-light));
    font-weight: 600;
  }
  .cmp__chip-mark {
    box-sizing: border-box;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
  }
  .cmp__chip[aria-pressed="true"] .cmp__chip-mark {
    background: currentColor;
  }
  .cmp__chip-tag {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    padding: 0 0.3rem;
  }
  .cmp__all {
    font: inherit;
    font-size: 0.78rem;
    padding: 0.24rem 0.6rem;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .cmp__all[aria-pressed="true"] {
    background: rgb(var(--gray-light));
    font-weight: 600;
  }

  .cmp__table {
    display: block;
  }
  .cmp__head,
  .cmp__row {
    display: grid;
    grid-template-columns: var(--cmp-cols);
  }
  .cmp__th {
    padding: 0.45rem 0.6rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgb(var(--gray));
    border-bottom: 1px solid var(--border-subtle);
  }
  .cmp__group-head {
    background-color: rgb(var(--gray-light));
  }
  .cmp__locale {
    padding: 0.35rem 0.6rem;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .cmp__cell {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .cmp__input {
    flex-direction: row;
    align-items: flex-start;
    gap: 0.25rem;
  }
  .cmp__form {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85rem;
    white-space: nowrap;
  }
  .cmp__more {
    font: inherit;
    line-height: 1;
    border: 1px solid var(--border-subtle);
    border-radius: 4px;
    background: transparent;
    color: rgb(var(--gray));
    cursor: pointer;
    padding: 0 0.25rem;
  }

  /* One stacked line per engine: label · play · text. */
  .cmp__lang {
    display: grid;
    grid-template-columns: 6.5rem auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.45rem;
  }
  .cmp__lang-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgb(var(--gray));
    white-space: nowrap;
  }
  .cmp__play {
    flex: 0 0 auto;
    font: inherit;
    font-size: 0.8rem;
    line-height: 1;
    padding: 0 0.35rem;
    border: 1px solid var(--border-subtle);
    border-radius: 5px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .cmp__text {
    min-width: 0;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.88rem;
  }
  .cmp__text--pred {
    opacity: 0.82;
  }
  .cmp__text--phon {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
  }
  .cmp__row[data-open="1"] .cmp__text {
    -webkit-line-clamp: unset;
    display: block;
  }
  .cmp__roman {
    grid-column: 3;
    font-size: 0.78rem;
    font-style: italic;
    color: rgb(var(--gray));
  }
  .cmp__none {
    grid-column: 3;
    font-size: 0.82rem;
    color: rgb(var(--gray));
  }

  .cmp[data-a="0"] .cmp__col--a,
  .cmp[data-b="0"] .cmp__col--b,
  .cmp[data-c="0"] .cmp__col--c,
  .cmp[data-d="0"] .cmp__col--d {
    display: none;
  }

  /* Mobile: stacked cards. */
  @media (max-width: 760px) {
    .cmp {
      --cmp-cols: 1fr;
    }
    .cmp__head {
      display: none;
    }
    .cmp__row {
      padding: 0.35rem 0;
      border-bottom: 1px solid var(--border-subtle);
    }
    .cmp__cell {
      border-bottom: 0;
      padding: 0.25rem 0.65rem;
    }
    .cmp__input {
      padding-top: 0.55rem;
    }
    .cmp__input .cmp__form {
      font-size: 0.95rem;
      font-weight: 600;
    }
    .cmp__lang {
      grid-template-columns: 5.5rem auto minmax(0, 1fr);
    }
    .cmp__text {
      -webkit-line-clamp: 2;
    }
  }

  /* Rendered via set:html, so these spans carry no Astro scope attribute;
     the colour rules must be global to reach them. */
  :global(.tx-currency) {
    color: var(--tx-currency);
    font-weight: 600;
  }
  :global(.tx-number) {
    color: var(--tx-number);
  }
  :global(.tx-point) {
    color: var(--tx-point);
    font-style: italic;
  }
  :global(.tx-minor) {
    color: var(--tx-minor);
    background-color: var(--tx-minor-bg);
    border-radius: 3px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>
