---
import fs from "node:fs";
import path from "node:path";
import { renderTranscriptHtml } from "../../lib/transcript-render.mjs";

// The clips live under public/ (served as-is) and are listed in a manifest so
// the table can never drift from the files on disk. The manifest also carries
// the human-readable form, which is what lets the table show <local> currency
// rows without parsing the (lossy) filename encoding.
const slug = "screen-reader-currency-announcements";
const manifestPath = path.join(
  process.cwd(),
  "public/posts",
  slug,
  "artifacts/RESULTS-gtts-locales.tsv"
);
const clipsDir = path.join(process.cwd(), "public/posts", slug, "artifacts/gtts");

const rows: { locale: string; form: string; file: string }[] = [];
if (fs.existsSync(manifestPath)) {
  const lines = fs.readFileSync(manifestPath, "utf8").split("\n");
  for (const line of lines) {
    if (!line.trim() || line.startsWith("locale\t")) continue;
    const [locale, form, file] = line.split("\t");
    if (locale && form && file && fs.existsSync(path.join(clipsDir, file))) {
      rows.push({ locale, form, file });
    }
  }
}

// Transcripts are optional and filled in by hand; keyed by filename.
const transcriptFile = path.join(process.cwd(), "content/posts", slug, "transcripts.json");
const transcripts: Record<string, string> = fs.existsSync(transcriptFile)
  ? JSON.parse(fs.readFileSync(transcriptFile, "utf8"))
  : {};

// Optional romanization for the non-Latin read-outs; keyed by filename.
const romanFile = path.join(process.cwd(), "content/posts", slug, "transcripts.romanized.json");
const romanized: Record<string, string> = fs.existsSync(romanFile)
  ? JSON.parse(fs.readFileSync(romanFile, "utf8"))
  : {};

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const srcFor = (file: string) => `${base}posts/${slug}/artifacts/gtts/${file}`;

// Group by locale, preserving manifest order (the locale's own currency is last).
const groups = new Map<string, { form: string; file: string }[]>();
for (const { locale, form, file } of rows) {
  const list = groups.get(locale) ?? [];
  list.push({ form, file });
  groups.set(locale, list);
}
const locales = [...groups.keys()];
---

<div class="ag">
  <p class="ag__meta">{rows.length} clips</p>

  <p class="ag__legend">
    <span class="tx-currency">currency</span>
    <span class="tx-number">number</span>
    <span class="tx-point">point</span>
    <span class="tx-minor">minor unit</span>
  </p>

  <table>
    <thead>
      <tr><th>Input</th><th>Audio</th><th>Transcript</th></tr>
    </thead>
    <tbody>
      {
        locales.map((locale) => (
          <>
            <tr class="ag__locale">
              <th colspan="3">{locale}</th>
            </tr>
            {groups.get(locale)!.map(({ form, file }) => {
              const raw = (transcripts[file] ?? "").trim();
              const predicted = raw.startsWith("~");
              const text = predicted ? raw.replace(/^~\s*/, "") : raw;
              const html = renderTranscriptHtml(text, locale);
              const roman = (romanized[file] ?? "").trim();
              return (
                <tr>
                  <td class="ag__form">{form}</td>
                  <td>
                    <audio controls preload="none" src={srcFor(file)} data-file={file} />
                  </td>
                  <td class="ag__transcript">
                    {predicted && <span class="ag__tag">predicted</span>}
                    <span class={predicted ? "ag__guess" : ""} set:html={html} />
                    {roman && <span class="ag__roman">{roman}</span>}
                  </td>
                </tr>
              );
            })}
          </>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .ag {
    margin: 1.5rem auto 2.5rem;
  }
  .ag__meta {
    margin: 0.6rem 0 0.4rem;
    font-size: 0.85rem;
    color: rgb(var(--gray));
  }
  .ag table {
    width: 100%;
    border-collapse: collapse;
  }
  .ag th,
  .ag td {
    text-align: left;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }
  .ag th {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgb(var(--gray));
  }
  .ag__locale th {
    background-color: rgb(var(--gray-light));
    font-size: 0.95rem;
    text-transform: none;
    letter-spacing: 0;
  }
  .ag__form {
    font-family: var(--font-mono, ui-monospace, monospace);
    white-space: nowrap;
  }
  .ag audio {
    height: 2rem;
    vertical-align: middle;
  }
  .ag__transcript {
    font-size: 0.9rem;
  }
  .ag__roman {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8rem;
    font-style: italic;
    color: rgb(var(--gray));
  }
  .ag__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0 0 0.6rem;
    font-size: 0.78rem;
  }
  .ag__legend span::before {
    content: "●";
    margin-right: 0.3rem;
  }
  /* Rendered via set:html, so these spans carry no Astro scope attribute;
     the colour rules must be global to reach them. Colours come from the
     theme variables so both light and dark (data-color-scheme) work. Extra
     cues are font weight (currency), italic (point) and a faint fill (minor);
     number stays plain so nothing crosses CJK glyphs (no underlines). */
  :global(.tx-currency) {
    color: var(--tx-currency);
    font-weight: 600;
  }
  :global(.tx-number) {
    color: var(--tx-number);
  }
  :global(.tx-point) {
    color: var(--tx-point);
    font-style: italic;
  }
  :global(.tx-minor) {
    color: var(--tx-minor);
    background-color: var(--tx-minor-bg);
    border-radius: 3px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>
