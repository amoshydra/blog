---
const today = new Date();
---

<footer>
  &copy; {today.getFullYear()}
  <a
    class="profile-link"
    href="https://github.com/amoshydra"
    title="Visit Amos' Github Profile"
  >
    amoshydra
    <span class="sr-only">Visit Amos' Github profile</span>
  </a>.
  All rights reserved.
</footer>
<style>
footer {
  padding: 2em 1em 6em 1em;
  background: linear-gradient(var(--gray-gradient)) no-repeat;
  color: rgb(var(--gray));
  text-align: center;
}

.profile-link {
  display: inline-block;
  text-decoration: none;
  padding: 0.25rem 0.25rem;
  color: currentColor;
  border-radius: 0.25rem;
  line-height: 1;
  margin: -0.125rem;

  background-color: var(--profile-link-bg);
}

@media (hover: hover) and (pointer: fine) {
  .profile-link:hover {
    background-color: var(--profile-link-bg-hover);
  }
}

.profile-link:active {
  background-color: var(--profile-link-bg-active);
}
</style>
